[Unit]
Description=Weather Station Client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple

# Set these four to match your installation. The user needs membership of the
# gpio, i2c and spi groups to read the WeatherHAT.
User=pi
Group=pi
WorkingDirectory=/home/pi/weather_station/client

# Settings and secrets live outside the repository. Copy .env.example to
# /etc/weather-client.env and set API_KEY there.
EnvironmentFile=/etc/weather-client.env

ExecStart=/home/pi/weather_station/client/.venv/bin/weather-client

# Provides /var/lib/weather-client for the SQLite buffer.
StateDirectory=weather-client

Restart=on-failure
RestartSec=30

# The collector shuts down in well under a second. Do not wait 90.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
