[Unit]
Description=Weather Station Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/weather_station/client
Environment="PATH=/home/pi/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/pi/.cargo/bin/uv run weather-client
Restart=always
Environment="SERVER_URL=http://pi4:8080"
Environment="API_KEY=your-api-key-here"
Environment="STATION_ID=piw"
Environment="UPLOAD_INTERVAL=300"
Environment="HEALTH_UPLOAD_INTERVAL=300"
Environment="DATABASE_PATH=/data/weather.db"
Environment="TEMPERATURE_OFFSET=-6.0"
Environment="ENABLED_SENSORS=wind"
Environment="LOG_LEVEL=INFO"
RestartSec=10

[Install]
WantedBy=multi-user.target
