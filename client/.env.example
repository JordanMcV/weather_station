# Weather Client Configuration (Pi Zero)

# Server connection
SERVER_URL=http://pi5:8080
API_KEY=your-api-key-here

# Station identity
STATION_ID=piw

# Upload behavior
UPLOAD_INTERVAL=300          # Upload every 5 minutes
SENSOR_READ_INTERVAL=15.0    # Read sensor every 15 seconds

# Buffer settings
BUFFER_MAX_SIZE=1000
DATABASE_PATH=/tmp/weather.db

# Retry behavior
RETRY_ATTEMPTS=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0

# Sensor calibration
TEMPERATURE_OFFSET=-6.0

# Logging
LOG_LEVEL=INFO
