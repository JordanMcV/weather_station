# Weather Client Configuration (Raspberry Pi Zero)

# Server connection
SERVER_URL=http://<server-host>:8080
API_KEY=your-api-key-here

# Station identity
STATION_ID=<station-name>

# Upload behavior
UPLOAD_INTERVAL=300          # Upload every 5 minutes
UPLOAD_BATCH_SIZE=500        # Readings per request when draining a backlog
SENSOR_READ_INTERVAL=15.0    # Read sensor every 15 seconds
HEALTH_UPLOAD_INTERVAL=300   # Report system health every 5 minutes

# Buffer settings
BUFFER_MAX_SIZE=17280
DATABASE_PATH=/var/lib/weather-client/weather.db

# Retry behavior
RETRY_ATTEMPTS=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0

# Optional sensors. Choose from: wind, rain
# The rain gauge does not register water, so it stays off until it is repaired.
ENABLED_SENSORS=wind

# Sensor calibration. The library subtracts this from the BME280 reading to
# compensate for Pi self-heating. Keep it at 0.0 while the Pi and the WeatherHAT
# are separated by a ribbon cable inside an aspirated screen.
TEMPERATURE_OFFSET=0.0

# Logging
LOG_LEVEL=INFO
