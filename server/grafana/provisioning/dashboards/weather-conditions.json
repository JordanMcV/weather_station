        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "insertNulls": 900000
