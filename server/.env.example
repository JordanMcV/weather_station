# Weather Server Configuration (pi4)

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# InfluxDB connection
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=weather
INFLUXDB_BUCKET=weather_data

# For docker-compose initial setup
INFLUXDB_ADMIN_PASSWORD=your-admin-password
GRAFANA_ADMIN_PASSWORD=your-grafana-password

# Public URL for Grafana. Set this to the tailnet address when Grafana is
# served over Tailscale, otherwise redirects and asset links break.
GRAFANA_ROOT_URL=http://localhost:3000/

# Timestamp acceptance window. Readings outside it are dropped and counted,
# because the collector has no real time clock.
MAX_TIMESTAMP_FUTURE_SECONDS=3600
MAX_TIMESTAMP_AGE_DAYS=30

# Security
API_KEY=your-api-key-here

# Browser access. Leave empty to keep CORS off, which suits a collector-only API.
# Set a comma separated origin list if a browser client needs access.
CORS_ALLOW_ORIGINS=

# Logging
LOG_LEVEL=INFO
