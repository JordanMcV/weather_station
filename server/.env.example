# Weather Server Configuration (Pi 5)

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# InfluxDB connection
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=weather
INFLUXDB_BUCKET=weather_data

# For docker-compose initial setup
INFLUXDB_ADMIN_PASSWORD=your-admin-password
GRAFANA_ADMIN_PASSWORD=your-grafana-password

# Security
API_KEY=your-api-key-here

# Logging
LOG_LEVEL=INFO
