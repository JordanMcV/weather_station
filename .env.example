# Weather Station Monorepo - Root Environment Variables
# This file contains example environment variables for the entire system
# Copy specific sections to client/.env or server/.env as needed

# ==============================================================================
# CLIENT (Pi Zero) CONFIGURATION - See client/.env.example
# ==============================================================================

# Server connection
SERVER_URL=http://pi5:8080
STATION_ID=piw
API_KEY=your-api-key-here

# Upload and sensor settings
UPLOAD_INTERVAL=300
SENSOR_READ_INTERVAL=15.0
TEMPERATURE_OFFSET=-6.0

# Buffer settings
BUFFER_MAX_SIZE=1000
DATABASE_PATH=/tmp/weather.db

# ==============================================================================
# SERVER (Pi 5) CONFIGURATION - See server/.env.example
# ==============================================================================

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# InfluxDB connection
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=weather
INFLUXDB_BUCKET=weather_data

# Initial setup passwords
INFLUXDB_ADMIN_PASSWORD=your-admin-password
GRAFANA_ADMIN_PASSWORD=your-grafana-password

# ==============================================================================
# COMMON CONFIGURATION
# ==============================================================================

# Logging
LOG_LEVEL=INFO